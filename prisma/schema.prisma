generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Turno {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Datos del cliente
  nombre      String
  email       String
  telefono    String
  dni         String?

  // Datos del turno
  servicio    String?
  modalidad   String?  // "Presencial" | "Virtual"
  canal       String?  // si es Virtual: "Zoom" | "Google Meet" | "WhatsApp (videollamada)"
  fecha       DateTime
  horaInicio  String   // ej: "10:00"
  horaFin     String   // ej: "11:00"
  mensaje     String?

  // Estado del turno
  estado      EstadoTurno @default(PENDIENTE)
  notaAdmin   String?
  enlace      String?  // link de la videollamada (turnos virtuales)

  // Toda consulta de disponibilidad filtra por el día.
  @@index([fecha])
  @@map("turnos")
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  CANCELADO
  COMPLETADO
}

model CalendarConfig {
  id        String   @id @default("main")
  config    Json
  updatedAt DateTime @updatedAt

  @@map("calendar_config")
}

/// Único administrador del panel (Javier). La contraseña se guarda hasheada con
/// scrypt; ADMIN_SECRET dejó de ser la clave y solo firma las sesiones.
model AdminUser {
  id           String   @id @default("main")
  email        String
  passwordHash String
  /// Se incrementa al cambiar la contraseña: invalida todas las sesiones
  /// abiertas sin necesidad de una tabla de sesiones.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_user")
}

/// Códigos de un solo uso que se mandan por email como segundo factor del login.
model AdminLoginCode {
  id        String    @id @default(cuid())
  /// sha256 del código de 6 dígitos: no se guarda en claro.
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  /// Para limpiar los vencidos y contar cuántos se emitieron en la última hora.
  @@index([createdAt])
  @@map("admin_login_codes")
}
