# Base de datos (PostgreSQL en Vercel/Neon o Supabase)
DATABASE_URL="postgresql://usuario:password@host:5432/estudio_pvc"

# Brevo - SOLO para el correo de confirmación al cliente.
# El aviso interno al estudio va por SMTP propio (ver más abajo): DonWeb rechaza
# los envíos de Brevo con "550 5.7.1 Blacklisted [France, Europe]".
# Crear cuenta en https://brevo.com y generar una API key en SMTP & API > API Keys
# EMAIL_FROM debe ser un remitente o dominio verificado en Brevo (Senders, Domains & Dedicated IPs)
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="turnos@mail.estudiojuridicoperalta.com"
EMAIL_ADMIN="javier@estudiojuridicoperalta.com"

# SMTP del hosting - SOLO para el aviso interno de turno nuevo al estudio.
# El host es c205.ferozo.com y NO mail.estudiojuridicoperalta.com: los dos apuntan
# a la misma IP, pero el servidor presenta un certificado CN=*.ferozo.com que no
# cubre el dominio del estudio, y la verificación de TLS falla.
# La casilla turnero@ ya existía en el hosting, sin uso (Entrada, Enviados y
# Papelera vacías); se reutilizó en vez de crear una nueva. Se administra desde
# el panel de DonWeb, en Correos.
SMTP_HOST="c205.ferozo.com"
SMTP_PORT="465"
SMTP_USER="turnero@estudiojuridicoperalta.com"
SMTP_PASS="la-clave-de-esa-casilla"

# Admin panel - clave simple para proteger el panel
ADMIN_SECRET="cambiar-por-clave-segura"

# URL del sitio (para links en emails). Canónico con www: la raíz redirige acá.
NEXT_PUBLIC_SITE_URL="https://www.estudiojuridicoperalta.com"
