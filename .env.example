# Base de datos (PostgreSQL en Vercel/Neon o Supabase)
DATABASE_URL="postgresql://usuario:password@host:5432/estudio_pvc"

# Brevo - para emails de notificación de turnos
# Crear cuenta en https://brevo.com y generar una API key en SMTP & API > API Keys
# EMAIL_FROM debe ser un remitente o dominio verificado en Brevo (Senders, Domains & Dedicated IPs)
BREVO_API_KEY="xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="turnos@mail.estudiojuridicoperalta.com"
EMAIL_ADMIN="javier@estudiojuridicoperalta.com"

# Admin panel - clave simple para proteger el panel
ADMIN_SECRET="cambiar-por-clave-segura"

# URL del sitio (para links en emails). Canónico con www: la raíz redirige acá.
NEXT_PUBLIC_SITE_URL="https://www.estudiojuridicoperalta.com"
